{
  "schemaVersion": 1,
  "id": "${id}",
  "version": "${version}",
  "name": "${name}",
  "description": "This mod/datapack enhances vanilla crafting by making them a lot faster.",
  "authors": [
    "kryparnold"
  ],
  "contact": {
    "homepage": "https://modrinth.com/mod/vanillacraftingplus",
    "sources": "https://github.com/kryparnold/vanilla-crafting-plus",
    "issues": "https://github.com/kryparnold/vanilla-crafting-plus/issues"
  },
  "license": "MIT",
  "icon": "assets/vanillacraftingplus/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.kryparnold.vanillacraftingplus.VanillaCraftingPlusFabric"
    ],
    "client": [
      "com.kryparnold.vanillacraftingplus.VanillaCraftingPlusClient"
    ]
  },
  "mixins": [
    "vanillacraftingplus.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.14",
    "fabric-api-base": "*",
    "${command_api}": "*",
    "fabric-networking-api-v1": "*",
    "fabric-resource-loader-v0": "*",
    "minecraft": "${minecraft}",
    "java": ">=${java}"
  }
}
